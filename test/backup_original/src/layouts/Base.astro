---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'QT新月 — 个人作品集 | 钟文清' } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content="钟文清的个人作品集 — 人工智能技术应用专业，深圳职业技术大学。涵盖深度学习、计算机视觉、数据工程、RPA 自动化、全栈开发等 12 个项目。">
<meta property="og:title" content="QT新月 — 钟文清的个人作品集">
<meta property="og:description" content="AI/数据工程/RPA 自动化/全栈开发 · 12 个实战项目 · 蓝桥杯省二等奖 · JLPT N2">
<meta property="og:type" content="website">
<meta property="og:url" content="https://qtxingyue.me/">
<meta property="og:site_name" content="QT新月">
<meta property="og:locale" content="zh_CN">
<meta property="og:image" content="https://qtxingyue.me/og-image.svg">
<meta property="og:image:type" content="image/svg+xml">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#6d28d9">
<meta name="keywords" content="钟文清,QT新月,个人作品集,Python,深度学习,计算机视觉,数据工程,深圳职业技术大学">
<meta name="view-transition" content="same-origin">
<link rel="canonical" href="https://qtxingyue.me/">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%236d28d9'/><text x='32' y='46' text-anchor='middle' font-size='36' font-family='sans-serif' fill='white'>月</text></svg>">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800;900&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&family=Zen+Old+Mincho:wght@400;700;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800;900&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&family=Zen+Old+Mincho:wght@400;700;900&display=swap"></noscript>
<script type="application/ld+json" is:inline>
{"@context":"https://schema.org","@type":"Person","name":"钟文清","alternateName":"QT新月","url":"https://qtxingyue.me/","image":"https://qtxingyue.me/og-image.svg","jobTitle":"人工智能技术应用学生 / 数据自动化开发者","affiliation":{"@type":"CollegeOrUniversity","name":"深圳职业技术大学"},"knowsAbout":["Python","Playwright","MediaPipe","OpenCV","TensorFlow","数据自动化","计算机视觉"],"sameAs":["https://github.com/qtXingYue"]}
</script>
<script is:inline>
  // 首屏前应用已保存主题，避免闪烁
  try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
</script>
</head>
<body>
<a href="#main" class="skip-link">跳至主要内容</a>
<main id="main">
