---
// 极致零闪烁 · 双视频交替方案（商业级）
// 两层 video 重叠，A 播放时预启动 B，A 结束瞬间切换 B 到顶层
// 全程无 seek 重置间隙，无 Canvas，浏览器原生渲染
// iOS 锚点 #t=0.1 强制预加载起始片段
// webm 优先（Chrome 解码压力小），mp4 兜底
---
<div class="bg-video-stack" id="bgVideoStack">
  <div class="bg-video-placeholder" id="bgVideoPlaceholder"></div>
  <video class="bg-video-layer" id="bgVideoA" muted playsinline preload="none" poster="/bg-poster.jpg" aria-hidden="true">
    <source src="/desktop-bg.webm#t=0.1" type="video/webm">
    <source src="/desktop-bg.mp4#t=0.1" type="video/mp4">
  </video>
  <video class="bg-video-layer" id="bgVideoB" muted playsinline preload="none" poster="/bg-poster.jpg" aria-hidden="true">
    <source src="/desktop-bg.webm#t=0.1" type="video/webm">
    <source src="/desktop-bg.mp4#t=0.1" type="video/mp4">
  </video>
</div>
<div class="bg-video-overlay" id="bgOverlay" aria-hidden="true"></div>

<script>
(function initVideoBg() {
  const videoA = document.getElementById('bgVideoA');
  const videoB = document.getElementById('bgVideoB');
  const stack = document.getElementById('bgVideoStack');
  const overlay = document.getElementById('bgOverlay');
  const placeholder = document.getElementById('bgVideoPlaceholder');
  const btn = document.getElementById('bgToggle');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.matchMedia('(max-width: 768px)').matches;
  const saveData = !!(navigator.connection && navigator.connection.saveData);
  // 移动端 / 省流模式 / 减少动态:默认不加载视频,只显示渐变占位
  let enabled = !reduced && !isMobile && !saveData;
  let active = videoA;
  let standby = videoB;
  let started = false;

  function onTimeUpdate() {
    if (this !== active || !started) return;
    const dur = active.duration;
    if (!dur || !isFinite(dur)) return;
    const remain = dur - active.currentTime;

    // 剩余 < 0.3s 时预启动 standby
    if (remain < 0.3 && remain > 0.05 && standby.paused) {
      standby.currentTime = 0;
      standby.play().catch(() => {});
    }

    // A 到达末尾：瞬间切换层级，A 暂停并重置为下一轮备胎
    if (remain <= 0.05 || active.ended) {
      active.classList.remove('active');
      standby.classList.add('active');
      active.pause();
      active.currentTime = 0;
      // 交换角色
      const tmp = active;
      active = standby;
      standby = tmp;
    }
  }

  videoA.addEventListener('timeupdate', onTimeUpdate);
  videoB.addEventListener('timeupdate', onTimeUpdate);

  function start() {
    if (started) return;
    started = true;
    active = videoA;
    standby = videoB;
    active.classList.add('active');
    standby.classList.remove('active');
    active.currentTime = 0;
    active.play().then(() => {
      if (placeholder) placeholder.classList.add('fade-out');
    }).catch(() => {
      // In case autoplay is blocked or fails initially, fade out anyway or wait for interaction
      if (placeholder) placeholder.classList.add('fade-out');
    });
  }

  function stop() {
    started = false;
    videoA.pause();
    videoB.pause();
    videoA.classList.remove('active');
    videoB.classList.remove('active');
    if (placeholder) placeholder.classList.remove('fade-out');
  }

  function apply() {
    if (enabled) {
      stack.classList.add('on');
      overlay.classList.add('on');
      start();
    } else {
      stack.classList.remove('on');
      overlay.classList.remove('on');
      stop();
    }
    if (btn) btn.style.opacity = enabled ? '1' : '0.45';
  }

  let loaded = 0;
  function onLoaded() {
    loaded++;
    if (loaded >= 1 && enabled && !started) apply();
  }
  videoA.addEventListener('loadeddata', onLoaded);
  videoB.addEventListener('loadeddata', onLoaded);
  videoA.addEventListener('canplay', () => { if (enabled && !started) apply(); });

  if (btn) btn.addEventListener('click', () => { enabled = !enabled; apply(); });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      videoA.pause();
      videoB.pause();
    } else if (enabled && started) {
      active.play().catch(() => {});
    }
  });

  apply();
})();
</script>
