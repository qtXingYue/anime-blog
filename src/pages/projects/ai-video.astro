---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const title = 'AI 视频作品 — QT新月';
const description = 'QT新月的 AI 生成视频作品展示。';
const slug = 'ai-video';
---

<ProjectLayout title={title} description={description} slug={slug} wide={true}>
  <section class="page-hero">
    <div class="page-hero-icon">🎬</div>
    <h1>AI 视频作品</h1>
    <p>AI 生成视频 · 创意内容 · 动态视觉</p>
  </section>

  <section class="video-section">
    <div class="video-card">
      <div class="video-wrapper">
        <video controls playsinline preload="metadata">
          <source src="/projects/ai-videos/ai-video-01.mp4" type="video/mp4">
          你的浏览器不支持视频播放
        </video>
      </div>
      <div class="video-info">
        <h2>AI 视频作品 #1</h2>
        <p class="meta">2026-06 · AI Generated</p>
        <div class="tags">
          <span class="tag">AI视频</span><span class="tag">AI创作</span>
        </div>
      </div>
    </div>
    <div class="video-card">
      <div class="video-wrapper">
        <video controls playsinline preload="metadata">
          <source src="/projects/ai-videos/ai-video-02.mp4" type="video/mp4">
          你的浏览器不支持视频播放
        </video>
      </div>
      <div class="video-info">
        <h2>AI 视频作品 #2</h2>
        <p class="meta">2026-06 · AI Generated</p>
        <div class="tags">
          <span class="tag">AI视频</span><span class="tag">AI创作</span>
        </div>
      </div>
    </div>
  </section>
</ProjectLayout>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800;900&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&family=Zen+Old+Mincho:wght@400;700;900&display=swap');

.page-hero { padding-block: 3rem 1.5rem; text-align: center; }
.page-hero-icon { font-size: 3rem; margin-bottom: 0.5rem; }
.page-hero h1 { font-family: 'Zen Old Mincho', serif; font-weight: 900; font-size: 2.5rem; }
.page-hero p { color: var(--text-secondary); font-size: 0.875rem; margin-top: 0.5rem; }

.video-section { padding-bottom: 3rem; }
.video-card {
  background: oklch(100% 0 0 / 0.04);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border); border-radius: 16px; overflow: hidden;
  margin-bottom: 1.5rem;
}
.video-wrapper { position: relative; background: #000; }
.video-wrapper video { width: 100%; display: block; max-height: 70vh; }
.video-info { padding: 1.25rem 1.5rem; }
.video-info h2 {
  font-family: 'M PLUS Rounded 1c', sans-serif; font-weight: 700; font-size: 1.25rem;
  color: var(--text-primary); margin: 0 0 0.25rem;
  padding-left: 0; border-left: none; display: block;
}
.video-info .meta { font-size: 0.75rem; color: var(--text-muted); margin: 0 0 0.5rem; }
.video-info .tags { display: flex; flex-wrap: wrap; gap: 4px; }
.tag {
  font-size: 0.65rem; padding: 2px 8px; border-radius: 100px;
  background: oklch(60% 0.18 280 / 0.08); color: var(--accent-soft);
  border: 1px solid oklch(60% 0.18 280 / 0.1);
}

@media (max-width: 640px) {
  .page-hero { padding-block: 2rem 1rem; }
  .page-hero h1 { font-size: 1.75rem; }
  .video-card { border-radius: 12px; margin-bottom: 1rem; }
  .video-wrapper video { max-height: 50vh; }
  .video-info { padding: 0.875rem 1rem; }
  .video-info h2 { font-size: 1.1rem; }
}
</style>
