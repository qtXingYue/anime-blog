---
import Base from '../layouts/Base.astro';
---
<Base title="页面未找到 — QT新月">
  <section class="section not-found">
    <div class="container" style="text-align:center;padding-block:var(--space-4xl)">
      <p class="section-label reveal" style="text-align:center">404</p>
      <h1 class="section-title reveal" style="text-align:center;margin-bottom:var(--space-lg)">页面未找到</h1>
      <p class="reveal" style="color:var(--text-secondary);margin-bottom:var(--space-2xl);max-width:480px;margin-inline:auto">
        抱歉，你访问的页面不存在或已被移除。
      </p>
      <a href="/" class="btn btn-primary">返回首页 →</a>
    </div>
  </section>
</Base>
