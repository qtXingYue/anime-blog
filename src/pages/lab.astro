---
// 实验室 — 视觉/交互实验品陈列页(与主站同壳)
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import VideoBg from '../components/VideoBg.astro';
import ClickFx from '../components/ClickFx.astro';

const experiments = [
  {
    no: '实验品一',
    title: '动效旗舰',
    desc: '重交互合集:鼠标粒子星座、自定义光标、磁吸按钮、3D 倾斜卡片、载入分字揭示、数字滚动。探索交互密度的上限。',
    tags: ['Canvas 粒子', '磁吸交互', '3D Tilt', '自定义光标'],
    thumb: '/lab/exp-01-thumb.webp',
    href: '/lab/exp-01-motion.html'
  },
  {
    no: '实验品二',
    title: 'Bento 科技',
    desc: 'Linear/Vercel 式克制路线:玻璃拟态 Bento 拼贴、鼠标聚光灯、卡片辉光追踪、交错揭示、双向技能跑马灯。探索「贵气」而非「炫技」。',
    tags: ['Bento Grid', '玻璃拟态', '聚光灯', '辉光追踪'],
    thumb: '/lab/exp-02-thumb.webp',
    href: '/lab/exp-02-bento.html'
  },
  {
    no: '实验品三',
    title: '前沿交互工坊',
    desc: 'React Bits 精选自研版:字符终端解密(Decrypted Text)、GPU 流光流动边框(Star Border)、动态景深失焦聚焦(True Focus)、物理像素力场与微火花。',
    tags: ['字符解密', 'Star Border', 'True Focus', '像素力场'],
    thumb: '/lab/exp-03-thumb.webp',
    href: '/lab/exp-03-bits.html'
  },
  {
    no: '实验品四',
    title: 'Obsidian 黑金高定重构',
    desc: '针对主站视觉的杂志化精修实验：非对称暗角遮罩、凝脂白金主标题、东方黑金印章、2×2 极客技能舱、香槟金荣誉勋章墙与极客终端项目卡。',
    tags: ['黑金杂志风', '2×2 技能舱', '勋章矩阵', '全域聚光灯'],
    thumb: '/projects/covers/00-featured.webp',
    href: '/lab/exp-04-editorial.html'
  },
  {
    no: '实验品五 · NEW',
    title: '新月画報 · 新海诚晴空日系特刊',
    desc: '与暗色科技风形成极致反差的明亮映画画报：融合日式竖排大字、结绳朱红线索、《你的名字》随笔引言、三段天色（晴空/黄昏之时/彗星夜空）切换与 35mm 胶片目录检视器。',
    tags: ['新海诚天色系统', '日式竖排画报', '35mm 胶片检视器', '瑞士出版网格'],
    thumb: '/projects/covers/06-cartoon-gan.webp',
    href: '/lab/exp-05-shinkai-zine.html'
  }
];
---
<Base title="实验室 — QT新月 | 视觉与交互实验">
  <div class="scroll-progress" id="scrollProgress"></div>
  <div class="noise-overlay" aria-hidden="true"></div>
  <VideoBg />
  <Header />

  <section class="section lab-hero">
    <div class="container">
      <p class="section-label reveal">LAB</p>
      <h2 class="section-title reveal">实验室</h2>
      <div class="section-divider reveal"></div>
      <p class="lab-intro reveal">
        这里陈列没有进入主站的视觉与交互实验——每一件都是完整可玩的原型。
        风格会互相冲突,想法不一定成熟,但都动手做出来了。
      </p>
    </div>
  </section>

  <section class="section lab-list">
    <div class="container">
      <div class="lab-grid">
        {experiments.map(e => (
          <a class="lab-card reveal" href={e.href} target="_blank" rel="noopener">
            <div class="lab-card-media">
              <img src={e.thumb} alt={`${e.no} ${e.title} 预览`} loading="lazy" decoding="async" width="880" height="550" />
              <span class="lab-card-open">打开体验 ↗</span>
            </div>
            <div class="lab-card-body">
              <p class="lab-card-no">{e.no}</p>
              <h3 class="lab-card-title">{e.title}</h3>
              <p class="lab-card-desc">{e.desc}</p>
              <div class="lab-card-tags">
                {e.tags.map(t => <span class="skill-tag">{t}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
  <BackToTop />
  <ClickFx />
</Base>

<style>
  .lab-hero { padding-bottom: 0; }
  .lab-intro {
    max-width: 560px; color: var(--text-secondary);
    font-size: var(--text-base); line-height: 1.9;
    margin-top: calc(-1 * var(--space-md));
  }
  .lab-list { padding-top: var(--space-2xl); }
  .lab-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg);
  }
  .lab-card {
    display: flex; flex-direction: column; overflow: hidden;
    background: linear-gradient(145deg, var(--bg-raised), var(--bg-high));
    border: 1px solid var(--border); border-radius: 20px;
    color: inherit; text-decoration: none;
    transition: transform 350ms var(--ease-out-expo), border-color 300ms, box-shadow 350ms;
  }
  a.lab-card:hover {
    transform: translateY(-4px);
    border-color: oklch(60% 0.18 280 / 0.45);
    box-shadow: 0 24px 60px oklch(0% 0 0 / 0.35), 0 0 0 1px oklch(60% 0.18 280 / 0.2);
  }
  .lab-card-media {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .lab-card-media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 600ms var(--ease-out-expo);
  }
  a.lab-card:hover .lab-card-media img { transform: scale(1.05); }
  .lab-card-open {
    position: absolute; right: 12px; bottom: 12px;
    font-size: var(--text-xs); font-weight: 600; color: #fff;
    background: oklch(0% 0 0 / 0.55); backdrop-filter: blur(10px);
    border: 1px solid oklch(100% 0 0 / 0.2); border-radius: 100px;
    padding: 6px 14px; opacity: 0; transform: translateY(6px);
    transition: opacity 300ms, transform 300ms var(--ease-out-expo);
  }
  a.lab-card:hover .lab-card-open { opacity: 1; transform: translateY(0); }
  .lab-card-body { padding: var(--space-lg) var(--space-xl) var(--space-xl); }
  .lab-card-no {
    font-family: var(--font-serif); font-size: var(--text-xs); color: var(--gold);
    letter-spacing: 0.18em; margin-bottom: var(--space-xs);
  }
  .lab-card-title {
    font-family: var(--font-serif); font-weight: 900;
    font-size: var(--text-xl); margin-bottom: var(--space-sm);
  }
  .lab-card-desc {
    font-size: var(--text-sm); color: var(--text-secondary);
    line-height: 1.8; margin-bottom: var(--space-md);
  }
  .lab-card-tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  @media (max-width: 768px) {
    .lab-grid { grid-template-columns: 1fr; }
  }
</style>
