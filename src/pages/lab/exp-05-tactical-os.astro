---
// 实验品五：MAGI // TACTICAL WORKBENCH OS (EVA / FF7 赛博工业平铺终端桌面)
// 100% 绑定 src/data 真实数据，采用单屏主从检视器 + 交互式 CLI 终端架构
import { featured, projectsMain, projectsAI, projectsWeb } from '../../data/projects';
import { skillCategories, stats } from '../../data/skills';
import { honors, experience } from '../../data/timeline';

const safeHref = (href: string) => (href.startsWith('/') ? href : '/' + href);

const allProjects = [
  {
    num: '00',
    category: '全栈架构',
    emoji: featured.emoji,
    title: featured.title,
    desc: featured.desc,
    highlight: { value: '100/100', label: 'Lighthouse 性能满分 · Astro 5 + GSAP' },
    metrics: ['19 个静态编译页', '15 个 FastAPI 端点', 'OKLCH 双主题系统'],
    tech: featured.tags.map(t => t.label),
    cover: featured.cover,
    link: { href: safeHref(featured.href), label: '启动架构报告' },
    group: 'web'
  },
  ...projectsMain.map(p => ({ ...p, link: p.link ? { ...p.link, href: safeHref(p.link.href) } : undefined, group: 'data' })),
  ...projectsAI.map(p => ({ ...p, link: p.link ? { ...p.link, href: safeHref(p.link.href) } : undefined, group: 'ai' })),
  ...projectsWeb.map(p => ({ ...p, link: p.link ? { ...p.link, href: safeHref(p.link.href) } : undefined, group: 'web' })),
].sort((a, b) => a.num.localeCompare(b.num));
---
<!DOCTYPE html>
<html lang="zh-CN" data-tac-theme="nerv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>实验品五 · MAGI 战术指令终端 — QT新月实验室</title>
  <meta name="description" content="QT新月作品集 实验品五：基于 EVA NERV 与 FF7 魔晄工业美学的平铺式战术终端工作台 UI。" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <!-- CRT 扫描线与暗角物理遮罩层 -->
  <div class="crt-scanlines" aria-hidden="true"></div>
  <div class="crt-vignette" aria-hidden="true"></div>

  <div class="os-shell">
    <!-- ═══ 顶部战术状态栏 (TOP HUD BAR) ═══ -->
    <header class="os-topbar">
      <div class="topbar-left">
        <a href="/lab.html" class="os-back-btn" title="返回实验室">◁ EXIT TO LAB</a>
        <span class="os-brand">
          <i class="os-pulse"></i>
          <b>MAGI // QT-XINGYUE</b>
          <small>SYS.VER 2026.05</small>
        </span>
      </div>

      <div class="topbar-center" aria-hidden="true">
        <span class="hud-ticker">OPERATOR: ZHONG WENQING [钟文清]</span>
        <span class="hud-sep">//</span>
        <span class="hud-ticker">LOC: SHENZHEN 22.54°N 114.05°E</span>
        <span class="hud-sep">//</span>
        <span class="hud-ticker status-ok">STATUS: OPEN FOR AI & DATA ENG.</span>
      </div>

      <div class="topbar-right">
        <div class="theme-switcher" role="group" aria-label="战术配色切换">
          <button type="button" class="tac-theme-btn active" data-set-theme="nerv">NERV 琥珀</button>
          <button type="button" class="tac-theme-btn" data-set-theme="mako">MAKO 魔晄</button>
          <button type="button" class="tac-theme-btn" data-set-theme="matrix">MATRIX 荧光</button>
        </div>
        <span class="os-clock" id="osClock">00:00:00.00</span>
      </div>
    </header>

    <!-- ═══ 主平铺工作区 (3-COLUMN TILING WORKSPACE) ═══ -->
    <main class="os-workspace">
      
      <!-- ── 左栏：操作员档案 + 核心遥测指标 + 技能载荷 ── -->
      <aside class="os-panel panel-left">
        <div class="panel-header">
          <span class="panel-code">UNIT-01 // OPERATOR DOSSIER</span>
          <span class="panel-tag">SYNC 99.2%</span>
        </div>

        <div class="operator-card">
          <div class="op-seal">月</div>
          <div class="op-meta">
            <h1>QT新月 <span>/ 钟文清</span></h1>
            <p class="op-role">AI · DATA ENGINEERING · RPA</p>
            <p class="op-school">深圳职业技术大学 · 2026 届</p>
          </div>
        </div>

        <!-- 6 大核心指标网格 -->
        <div class="panel-subhead">TELEMETRY METRICS // 量化指标</div>
        <div class="tac-stats-grid">
          {stats.map((s, idx) => (
            <div class="tac-stat-box">
              <span class="tac-stat-idx">0{idx + 1}</span>
              <b class="tac-stat-val">{s.number}</b>
              <small class="tac-stat-lbl">{s.label}</small>
            </div>
          ))}
        </div>

        <!-- 技能矩阵折叠舱 -->
        <div class="panel-subhead">SKILL PAYLOAD // 技能矩阵</div>
        <div class="tac-skills-list">
          {skillCategories.map((cat, idx) => (
            <div class="tac-skill-group">
              <div class="tac-skill-head">
                <span>[0{idx + 1}] {cat.title}</span>
                <i>{cat.tags.length} MODS</i>
              </div>
              <div class="tac-skill-chips">
                {cat.tags.map(t => (
                  <span class={t.primary ? 'tac-chip primary' : 'tac-chip'}>{t.label}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </aside>

      <!-- ── 中栏：15 个项目战术检索矩阵 + 履历切换视图 ── -->
      <section class="os-panel panel-center" aria-label="项目与档案主矩阵">
        <div class="panel-header">
          <div class="filter-tabs" role="tablist">
            <button type="button" class="filter-tab active" data-filter="all">ALL UNITS (15)</button>
            <button type="button" class="filter-tab" data-filter="data">DATA & RPA (4)</button>
            <button type="button" class="filter-tab" data-filter="ai">AI & VISION (6)</button>
            <button type="button" class="filter-tab" data-filter="web">FULLSTACK & AIGC (5)</button>
            <button type="button" class="filter-tab" data-filter="logs">CHRONICLE // 履历与荣誉</button>
          </div>
          <span class="panel-tag" id="matrixCountTag">15 MODULES ONLINE</span>
        </div>

        <!-- 项目矩阵列表视图 -->
        <div class="matrix-grid" id="projectMatrixGrid">
          {allProjects.map((p, idx) => (
            <button
              type="button"
              class={`matrix-node ${idx === 1 ? 'selected' : ''}`}
              data-group={p.group}
              data-idx={idx}
            >
              <div class="node-top">
                <span class="node-num">#{p.num}</span>
                <span class="node-cat">{p.category}</span>
              </div>
              <div class="node-main">
                <span class="node-emoji" aria-hidden="true">{p.emoji}</span>
                <h2 class="node-title">{p.title}</h2>
              </div>
              <div class="node-bottom">
                <span class="node-tech">{p.tech.slice(0, 3).join(' · ')}</span>
                <span class="node-arrow">INSPECT ▸</span>
              </div>
            </button>
          ))}
        </div>

        <!-- 隐藏视图：荣誉与经历时间日志 (点击 CHRONICLE 切换) -->
        <div class="chronicle-view" id="chronicleView" hidden>
          <div class="chronicle-col">
            <h3 class="chronicle-head">🏆 HONORS & CERTS // 荣誉与认证</h3>
            {honors.map(h => (
              <div class="log-entry">
                <span class="log-date">[{h.date}]</span>
                <strong>{h.title}</strong>
                <p>{h.desc}</p>
              </div>
            ))}
          </div>
          <div class="chronicle-col">
            <h3 class="chronicle-head">⚡ FIELD EXPERIENCE // 实战经历</h3>
            {experience.map(e => (
              <div class="log-entry">
                <span class="log-date">[{e.date}] · {e.org}</span>
                <strong>{e.title}</strong>
                <p>{e.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ── 右栏：实时选中项目深度检视器 (LIVE INSPECTOR MONITOR) ── -->
      <aside class="os-panel panel-right" aria-live="polite">
        <div class="panel-header">
          <span class="panel-code">INSPECTOR // TARGET TELEMETRY</span>
          <span class="panel-tag" id="inspNumTag">UNIT #01</span>
        </div>

        <div class="inspector-body">
          <!-- 视觉预览监控窗 -->
          <div class="insp-monitor">
            <div class="insp-monitor-bar">
              <span>OPTICAL FEED // LIVE</span>
              <span id="inspCategory">核心工程</span>
            </div>
            <img id="inspCover" src="/projects/covers/01-data-crawler.webp" alt="项目预览" />
            <div class="insp-emoji-fallback" id="inspEmojiFallback" hidden>🕷️</div>
            <div class="insp-crosshair" aria-hidden="true"></div>
          </div>

          <!-- 标题与核心高亮指标 -->
          <div class="insp-head">
            <h2 id="inspTitle">多平台广告数据爬取系统</h2>
            <div class="insp-highlight" id="inspHighlightWrap">
              <b id="inspHighlightVal">328+</b>
              <span id="inspHighlightLbl">活跃广告账号在跑 · 覆盖 5 个平台</span>
            </div>
          </div>

          <p class="insp-desc" id="inspDesc">
            一套覆盖五大广告平台的自动化数据采集系统。Playwright 驱动浏览器、Token 双重认证，Streamlit 仪表盘一键生成报表，日常监控 300+ 广告账号的消耗数据。
          </p>

          <div class="panel-subhead">KEY METRICS // 核心工程指标</div>
          <ul class="insp-metrics" id="inspMetrics">
            <li>5 个广告平台</li>
            <li>328+ 活跃账号</li>
            <li>CSV/Excel 自动报表</li>
          </ul>

          <div class="panel-subhead">TECH STACK // 挂载技术栈</div>
          <div class="insp-tech" id="inspTech">
            <span class="tac-chip primary">Python</span>
            <span class="tac-chip primary">Playwright</span>
            <span class="tac-chip primary">Streamlit</span>
            <span class="tac-chip primary">REST API</span>
          </div>

          <div class="insp-actions">
            <a id="inspLink" href="/projects/data-crawler-report" class="tac-cta-btn">
              <span>LAUNCH TECHNICAL REPORT</span>
              <i>↗</i>
            </a>
            <a href="/" class="tac-secondary-btn">返回主站</a>
          </div>
        </div>
      </aside>
    </main>

    <!-- ═══ 底部交互式命令行终端 (INTERACTIVE CLI SHELL) ═══ -->
    <footer class="os-terminal">
      <div class="term-output" id="termOutput">
        <span class="term-sys">[MAGI-OS] Tactical Workbench initialized. Type <b>help</b> or click a command pill below:</span>
      </div>
      <div class="term-bar">
        <span class="term-prompt">qtxingyue@magi-01:~$</span>
        <form id="termForm" class="term-form">
          <input
            type="text"
            id="termInput"
            class="term-input"
            placeholder="输入指令 (help / skills / eva / open 01 / contact / clear)..."
            autocomplete="off"
            aria-label="终端命令行输入"
          />
        </form>
        <div class="term-quick-btns">
          <button type="button" data-cmd="help">help</button>
          <button type="button" data-cmd="skills">skills</button>
          <button type="button" data-cmd="eva">eva</button>
          <button type="button" data-cmd="contact">contact</button>
          <button type="button" data-cmd="clear">clear</button>
        </div>
      </div>
    </footer>
  </div>

  <!-- 注入序列化项目数据供前端零延迟检视切换 -->
  <script is:inline define:vars={{ allProjects }}>
    window.__MAGI_PROJECTS__ = allProjects;
  </script>

  <script is:inline>
  (function initMagiWorkbench() {
    const projects = window.__MAGI_PROJECTS__ || [];

    // 1. 顶部高精度战术时钟
    const clockEl = document.getElementById('osClock');
    function updateClock() {
      if (!clockEl) return;
      const now = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      const ms = String(Math.floor(now.getMilliseconds() / 10)).padStart(2, '0');
      clockEl.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}.${ms}`;
      requestAnimationFrame(updateClock);
    }
    requestAnimationFrame(updateClock);

    // 2. 战术主题色切换 (NERV / MAKO / MATRIX)
    document.querySelectorAll('.tac-theme-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-set-theme');
        if (!theme) return;
        document.documentElement.setAttribute('data-tac-theme', theme);
        document.querySelectorAll('.tac-theme-btn').forEach(b => b.classList.toggle('active', b === btn));
        printTerm(`Theme switched to [${theme.toUpperCase()}] protocol.`);
      });
    });

    // 3. 右侧检视器渲染函数
    const inspNumTag = document.getElementById('inspNumTag');
    const inspCategory = document.getElementById('inspCategory');
    const inspCover = document.getElementById('inspCover');
    const inspEmojiFallback = document.getElementById('inspEmojiFallback');
    const inspTitle = document.getElementById('inspTitle');
    const inspHighlightWrap = document.getElementById('inspHighlightWrap');
    const inspHighlightVal = document.getElementById('inspHighlightVal');
    const inspHighlightLbl = document.getElementById('inspHighlightLbl');
    const inspDesc = document.getElementById('inspDesc');
    const inspMetrics = document.getElementById('inspMetrics');
    const inspTech = document.getElementById('inspTech');
    const inspLink = document.getElementById('inspLink');

    function selectProject(idx) {
      const p = projects[idx];
      if (!p) return;

      document.querySelectorAll('.matrix-node').forEach(n => {
        n.classList.toggle('selected', Number(n.getAttribute('data-idx')) === idx);
      });

      if (inspNumTag) inspNumTag.textContent = `UNIT #${p.num}`;
      if (inspCategory) inspCategory.textContent = p.category;
      if (inspTitle) inspTitle.textContent = p.title;
      if (inspDesc) inspDesc.textContent = p.desc;

      // 判断封面是否为真实位图（SVG 示意封面用战术大图标展示更震撼）
      if (p.cover && !p.cover.endsWith('.svg')) {
        inspCover.src = p.cover;
        inspCover.hidden = false;
        inspEmojiFallback.hidden = true;
      } else {
        inspCover.hidden = true;
        inspEmojiFallback.textContent = p.emoji || '⚡';
        inspEmojiFallback.hidden = false;
      }

      if (p.highlight) {
        inspHighlightWrap.hidden = false;
        inspHighlightVal.textContent = p.highlight.value;
        inspHighlightLbl.textContent = p.highlight.label;
      } else {
        inspHighlightWrap.hidden = true;
      }

      if (inspMetrics) {
        inspMetrics.innerHTML = (p.metrics || []).map(m => `<li>${m}</li>`).join('');
      }
      if (inspTech) {
        inspTech.innerHTML = (p.tech || []).map(t => `<span class="tac-chip primary">${t}</span>`).join('');
      }
      if (inspLink && p.link) {
        inspLink.href = p.link.href;
        const linkSpan = inspLink.querySelector('span');
        if (linkSpan) {
          linkSpan.textContent = `LAUNCH // ${p.link.label.replace('→', '').trim()}`;
        }
      }
    }

    document.querySelectorAll('.matrix-node').forEach(node => {
      node.addEventListener('click', () => {
        const idx = Number(node.getAttribute('data-idx'));
        selectProject(idx);
        const p = projects[idx];
        if (p) printTerm(`Inspecting Unit #${p.num}: [${p.title}] — Ready.`);
      });
    });

    // 4. 顶部 Filter Tabs 过滤与履历视图切换
    const matrixGrid = document.getElementById('projectMatrixGrid');
    const chronicleView = document.getElementById('chronicleView');
    const matrixCountTag = document.getElementById('matrixCountTag');

    document.querySelectorAll('.filter-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        document.querySelectorAll('.filter-tab').forEach(t => t.classList.toggle('active', t === tab));

        if (filter === 'logs') {
          matrixGrid.hidden = true;
          chronicleView.hidden = false;
          if (matrixCountTag) matrixCountTag.textContent = 'ARCHIVE LOGS';
          printTerm('Loaded Operator Chronicle: Honors & Field Experience.');
          return;
        }

        matrixGrid.hidden = false;
        chronicleView.hidden = true;
        let visibleCount = 0;
        document.querySelectorAll('.matrix-node').forEach(node => {
          const match = filter === 'all' || node.getAttribute('data-group') === filter;
          node.hidden = !match;
          if (match) visibleCount++;
        });
        if (matrixCountTag) matrixCountTag.textContent = `${visibleCount} MODULES ONLINE`;
      });
    });

    // 5. 底部交互式 CLI 终端引擎
    const termOutput = document.getElementById('termOutput');
    const termForm = document.getElementById('termForm');
    const termInput = document.getElementById('termInput');

    function printTerm(html) {
      if (!termOutput) return;
      const line = document.createElement('div');
      line.className = 'term-line';
      line.innerHTML = `<span class="term-ts">[${new Date().toTimeString().slice(0, 8)}]</span> ${html}`;
      termOutput.appendChild(line);
      termOutput.scrollTop = termOutput.scrollHeight;
    }

    function execCommand(raw) {
      const cmd = raw.trim().toLowerCase();
      if (!cmd) return;
      printTerm(`<b class="term-echo">$ ${raw}</b>`);

      if (cmd === 'help') {
        printTerm('Available commands: <b>skills</b> | <b>honors</b> | <b>eva</b> | <b>open [00-14]</b> | <b>theme [nerv|mako|matrix]</b> | <b>contact</b> | <b>clear</b>');
      } else if (cmd === 'skills') {
        printTerm('Core Stack: <b>Python (Master)</b>, TensorFlow, PyTorch, MediaPipe, OpenCV, Playwright, FastAPI, Astro 5.');
      } else if (cmd === 'honors') {
        printTerm('Honors: 🏆 2025 蓝桥杯 Python 省二等奖 | ☁️ 华为云 HCCDA-AI 认证 | 🗾 日语 JLPT N2.');
      } else if (cmd === 'eva') {
        printTerm('<span class="status-warn">WARNING: PATTERN BLUE DETECTED! MAGI MELCHIOR-1, BALTHASAR-2, CASPER-3 ALL CONCUR: "God\'s in his heaven, all\'s right with the world."</span>');
      } else if (cmd === 'contact') {
        printTerm('GitHub: <a href="https://github.com/qtXingYue" target="_blank">github.com/qtXingYue</a> | Location: Shenzhen | Status: OPEN FOR WORK.');
      } else if (cmd === 'clear') {
        if (termOutput) termOutput.innerHTML = '';
      } else if (cmd.startsWith('open ')) {
        const num = cmd.replace('open ', '').trim().padStart(2, '0');
        const idx = projects.findIndex(p => p.num === num);
        if (idx !== -1) {
          selectProject(idx);
          printTerm(`Target Unit #${num} [${projects[idx].title}] locked in Inspector.`);
        } else {
          printTerm(`Error: Unit #${num} not found. Use 00 to 14.`);
        }
      } else if (cmd.startsWith('theme ')) {
        const t = cmd.replace('theme ', '').trim();
        const btn = document.querySelector(`.tac-theme-btn[data-set-theme="${t}"]`);
        if (btn) btn.click();
        else printTerm('Unknown theme. Choose: nerv | mako | matrix');
      } else {
        printTerm(`Command not recognized: "${raw}". Type <b>help</b> for available commands.`);
      }
    }

    if (termForm) {
      termForm.addEventListener('submit', e => {
        e.preventDefault();
        execCommand(termInput.value);
        termInput.value = '';
      });
    }
    document.querySelectorAll('.term-quick-btns button').forEach(btn => {
      btn.addEventListener('click', () => execCommand(btn.getAttribute('data-cmd') || ''));
    });

    // 默认选中 01 号王牌项目
    selectProject(1);
  })();
  </script>

  <style is:global>
    /* ═══ 战术色彩变量系统 (3 套 ACG 主题) ═══ */
    :root, [data-tac-theme="nerv"] {
      --tac-bg: #08090c;
      --tac-panel: #0e1017;
      --tac-panel-hi: #151924;
      --tac-accent: #ff9e00;       /* EVA NERV 琥珀橙 */
      --tac-accent-dim: rgba(255, 158, 0, 0.16);
      --tac-accent-border: rgba(255, 158, 0, 0.42);
      --tac-sec: #ff2a54;          /* NERV 警戒红 */
      --tac-ok: #00ff9d;           /* 同步率荧光绿 */
      --tac-text: #f1f5f9;
      --tac-muted: #7e8bb6;
      --tac-grid: rgba(255, 158, 0, 0.12);
      --font-mono: 'JetBrains Mono', 'Fira Code', 'SFMono-Regular', Consolas, 'PingFang SC', monospace;
    }

    [data-tac-theme="mako"] {
      --tac-bg: #060b10;
      --tac-panel: #0a131c;
      --tac-panel-hi: #102030;
      --tac-accent: #00f5d4;       /* FF7 魔晄青绿 */
      --tac-accent-dim: rgba(0, 245, 212, 0.15);
      --tac-accent-border: rgba(0, 245, 212, 0.42);
      --tac-sec: #38bdf8;
      --tac-ok: #a7f3d0;
      --tac-text: #ecfeff;
      --tac-muted: #6495b0;
      --tac-grid: rgba(0, 245, 212, 0.12);
    }

    [data-tac-theme="matrix"] {
      --tac-bg: #050a06;
      --tac-panel: #09130c;
      --tac-panel-hi: #0f2215;
      --tac-accent: #22c55e;       /* 黑客帝国荧光绿 */
      --tac-accent-dim: rgba(34, 197, 94, 0.15);
      --tac-accent-border: rgba(34, 197, 94, 0.42);
      --tac-sec: #eab308;
      --tac-ok: #4ade80;
      --tac-text: #f0fdf4;
      --tac-muted: #5e8c6a;
      --tac-grid: rgba(34, 197, 94, 0.12);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      height: 100%;
      background: var(--tac-bg);
      color: var(--tac-text);
      font-family: var(--font-mono);
      font-size: 13px;
      line-height: 1.5;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* 背景工业十字网格 */
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(to right, var(--tac-grid) 1px, transparent 1px),
        linear-gradient(to bottom, var(--tac-grid) 1px, transparent 1px);
      background-size: 32px 32px;
      opacity: 0.45;
    }

    .crt-scanlines {
      position: fixed; inset: 0; z-index: 900; pointer-events: none;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.18) 0px,
        rgba(0, 0, 0, 0.18) 1px,
        transparent 1px,
        transparent 3px
      );
      opacity: 0.6;
    }
    .crt-vignette {
      position: fixed; inset: 0; z-index: 901; pointer-events: none;
      background: radial-gradient(circle at center, transparent 65%, rgba(0, 0, 0, 0.65) 100%);
    }

    /* ═══ 主壳：100dvh 零页面滚动平铺桌面 ═══ */
    .os-shell {
      position: relative; z-index: 1;
      display: grid;
      grid-template-rows: 44px minmax(0, 1fr) 82px;
      height: 100dvh;
      padding: 8px;
      gap: 8px;
    }

    /* ═══ 顶部 HUD 状态栏 ═══ */
    .os-topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 14px;
      background: var(--tac-panel);
      border: 1px solid var(--tac-accent-border);
      clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
    }
    .topbar-left, .topbar-right, .topbar-center {
      display: flex; align-items: center; gap: 12px;
    }
    .os-back-btn {
      color: var(--tac-accent); text-decoration: none; font-weight: 700;
      padding: 4px 10px; border: 1px solid var(--tac-accent-border);
      background: var(--tac-accent-dim); font-size: 11px; letter-spacing: 0.06em;
      transition: all 150ms;
    }
    .os-back-btn:hover { background: var(--tac-accent); color: #000; }
    .os-brand { display: flex; align-items: center; gap: 8px; }
    .os-pulse {
      width: 8px; height: 8px; background: var(--tac-accent);
      box-shadow: 0 0 10px var(--tac-accent);
      animation: blink 1.4s infinite;
    }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
    .os-brand b { color: var(--tac-text); letter-spacing: 0.08em; font-size: 13px; }
    .os-brand small { color: var(--tac-accent); font-size: 10px; opacity: 0.85; }

    .hud-ticker { font-size: 11px; color: var(--tac-muted); letter-spacing: 0.05em; }
    .hud-sep { color: var(--tac-accent); opacity: 0.4; }
    .status-ok { color: var(--tac-ok); font-weight: 600; }
    .status-warn { color: var(--tac-sec); font-weight: 700; }

    .theme-switcher { display: flex; gap: 4px; }
    .tac-theme-btn {
      background: transparent; color: var(--tac-muted);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 3px 8px; font-family: inherit; font-size: 10px; font-weight: 700;
      cursor: pointer; transition: all 150ms;
    }
    .tac-theme-btn.active, .tac-theme-btn:hover {
      border-color: var(--tac-accent); color: #000; background: var(--tac-accent);
    }
    .os-clock {
      font-variant-numeric: tabular-nums; font-weight: 700;
      color: var(--tac-accent); font-size: 12px; min-width: 84px; text-align: right;
    }

    /* ═══ 三列平铺主工作台 ═══ */
    .os-workspace {
      display: grid;
      grid-template-columns: 310px minmax(0, 1fr) 380px;
      gap: 8px;
      min-height: 0;
    }

    .os-panel {
      background: rgba(14, 16, 23, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.12);
      display: flex; flex-direction: column;
      min-height: 0; overflow: hidden;
      position: relative;
    }
    .os-panel::before {
      content: ''; position: absolute; top: 0; left: 0; width: 14px; height: 2px;
      background: var(--tac-accent);
    }

    .panel-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 12px;
      background: rgba(255, 255, 255, 0.03);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      flex-shrink: 0;
    }
    .panel-code { font-size: 11px; font-weight: 700; color: var(--tac-accent); letter-spacing: 0.08em; }
    .panel-tag {
      font-size: 10px; padding: 1px 6px;
      background: var(--tac-accent-dim); color: var(--tac-accent);
      border: 1px solid var(--tac-accent-border);
    }
    .panel-subhead {
      font-size: 10px; font-weight: 700; color: var(--tac-muted);
      letter-spacing: 0.1em; padding: 10px 12px 6px;
      border-top: 1px dashed rgba(255, 255, 255, 0.08);
    }

    /* ── 左栏细节 ── */
    .panel-left { overflow-y: auto; scrollbar-width: thin; }
    .operator-card {
      display: flex; align-items: center; gap: 12px; padding: 12px;
    }
    .op-seal {
      width: 48px; height: 48px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; font-weight: 900; color: #000;
      background: var(--tac-accent);
      clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
    }
    .op-meta h1 { font-size: 15px; font-weight: 800; color: var(--tac-text); }
    .op-meta h1 span { font-size: 11px; color: var(--tac-muted); font-weight: 400; }
    .op-role { font-size: 11px; color: var(--tac-accent); font-weight: 700; margin-top: 2px; }
    .op-school { font-size: 11px; color: var(--tac-muted); }

    .tac-stats-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 0 12px 10px;
    }
    .tac-stat-box {
      background: var(--tac-panel-hi);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 8px; position: relative;
    }
    .tac-stat-idx { position: absolute; top: 4px; right: 6px; font-size: 9px; color: var(--tac-muted); opacity: 0.5; }
    .tac-stat-val { display: block; font-size: 15px; font-weight: 800; color: var(--tac-accent); }
    .tac-stat-lbl { display: block; font-size: 10px; color: var(--tac-muted); margin-top: 2px; }

    .tac-skills-list { padding: 0 12px 12px; display: flex; flex-direction: column; gap: 8px; }
    .tac-skill-group {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 8px;
    }
    .tac-skill-head {
      display: flex; justify-content: space-between; font-size: 11px;
      font-weight: 700; color: var(--tac-text); margin-bottom: 6px;
    }
    .tac-skill-head i { font-style: normal; font-size: 10px; color: var(--tac-accent); }
    .tac-skill-chips { display: flex; flex-wrap: wrap; gap: 4px; }
    .tac-chip {
      font-size: 10px; padding: 2px 7px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--tac-muted);
    }
    .tac-chip.primary {
      border-color: var(--tac-accent-border);
      color: var(--tac-accent);
      background: var(--tac-accent-dim);
      font-weight: 600;
    }

    /* ── 中栏：15 项目战术网格 ── */
    .filter-tabs { display: flex; gap: 4px; flex-wrap: wrap; }
    .filter-tab {
      background: transparent; color: var(--tac-muted);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 4px 10px; font-family: inherit; font-size: 11px; font-weight: 700;
      cursor: pointer; transition: all 150ms;
    }
    .filter-tab:hover { border-color: var(--tac-accent); color: var(--tac-text); }
    .filter-tab.active {
      background: var(--tac-accent); color: #000; border-color: var(--tac-accent);
    }

    .matrix-grid {
      padding: 10px; overflow-y: auto; flex: 1;
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px; align-content: start;
    }
    .matrix-node {
      text-align: left; font-family: inherit; color: inherit;
      background: var(--tac-panel-hi);
      border: 1px solid rgba(255, 255, 255, 0.09);
      padding: 10px; cursor: pointer;
      display: flex; flex-direction: column; justify-content: space-between;
      gap: 10px; min-height: 112px;
      clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
      transition: all 160ms ease;
    }
    .matrix-node:hover {
      border-color: var(--tac-accent-border);
      transform: translateY(-2px);
    }
    .matrix-node.selected {
      background: var(--tac-accent-dim);
      border-color: var(--tac-accent);
      box-shadow: inset 0 0 0 1px var(--tac-accent);
    }
    .node-top { display: flex; justify-content: space-between; align-items: center; width: 100%; }
    .node-num { font-size: 11px; font-weight: 800; color: var(--tac-accent); }
    .node-cat { font-size: 10px; color: var(--tac-muted); }
    .node-main { display: flex; align-items: flex-start; gap: 8px; }
    .node-emoji { font-size: 18px; line-height: 1; flex-shrink: 0; }
    .node-title { font-size: 12.5px; font-weight: 700; color: var(--tac-text); line-height: 1.35; }
    .node-bottom {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 10px; color: var(--tac-muted);
      border-top: 1px solid rgba(255, 255, 255, 0.06); padding-top: 6px; width: 100%;
    }
    .node-tech { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 70%; }
    .node-arrow { color: var(--tac-accent); font-weight: 700; }

    /* 履历与荣誉切换视图 */
    .chronicle-view {
      padding: 14px; overflow-y: auto; flex: 1;
      display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    }
    .chronicle-view[hidden], .matrix-grid[hidden] { display: none !important; }
    .chronicle-head {
      font-size: 12px; color: var(--tac-accent); margin-bottom: 10px;
      padding-bottom: 6px; border-bottom: 1px solid var(--tac-accent-border);
    }
    .log-entry {
      background: var(--tac-panel-hi); border-left: 2px solid var(--tac-accent);
      padding: 10px 12px; margin-bottom: 10px;
    }
    .log-date { display: block; font-size: 10px; color: var(--tac-accent); margin-bottom: 2px; }
    .log-entry strong { display: block; font-size: 12.5px; color: var(--tac-text); margin-bottom: 4px; }
    .log-entry p { font-size: 11.5px; color: var(--tac-muted); line-height: 1.6; }

    /* ── 右栏：リアルタイム检视器 (Inspector) ── */
    .inspector-body {
      padding: 12px; overflow-y: auto; flex: 1;
      display: flex; flex-direction: column; gap: 10px;
    }
    .insp-monitor {
      position: relative; aspect-ratio: 16 / 10; width: 100%;
      background: #050608; border: 1px solid var(--tac-accent-border);
      overflow: hidden; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .insp-monitor-bar {
      position: absolute; top: 0; left: 0; right: 0; z-index: 2;
      display: flex; justify-content: space-between;
      padding: 4px 8px; font-size: 10px;
      background: rgba(0, 0, 0, 0.75); color: var(--tac-accent);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .insp-monitor img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: contrast(1.04) saturate(1.05);
    }
    .insp-emoji-fallback {
      font-size: 56px; filter: drop-shadow(0 0 24px var(--tac-accent));
    }
    .insp-crosshair {
      position: absolute; inset: 12px; pointer-events: none;
      border: 1px dashed rgba(255, 255, 255, 0.12);
    }
    .insp-head h2 { font-size: 16px; font-weight: 800; color: var(--tac-text); line-height: 1.3; }
    .insp-highlight {
      margin-top: 6px; padding: 6px 10px;
      background: var(--tac-accent-dim); border-left: 3px solid var(--tac-accent);
      display: flex; align-items: baseline; gap: 8px;
    }
    .insp-highlight b { font-size: 16px; color: var(--tac-accent); }
    .insp-highlight span { font-size: 11px; color: var(--tac-text); }
    .insp-desc { font-size: 12px; color: var(--tac-muted); line-height: 1.7; }

    .insp-metrics {
      list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 6px;
    }
    .insp-metrics li {
      font-size: 11px; color: var(--tac-text);
      padding: 4px 8px; background: var(--tac-panel-hi);
      border-left: 2px solid var(--tac-ok);
    }
    .insp-tech { display: flex; flex-wrap: wrap; gap: 5px; }

    .insp-actions {
      margin-top: auto; padding-top: 10px;
      display: grid; grid-template-columns: 1fr auto; gap: 8px;
    }
    .tac-cta-btn {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px; background: var(--tac-accent); color: #000;
      font-weight: 800; font-size: 12px; text-decoration: none;
      letter-spacing: 0.05em; transition: filter 150ms, transform 150ms;
    }
    .tac-cta-btn:hover { filter: brightness(1.12); transform: translateY(-1px); }
    .tac-secondary-btn {
      display: flex; align-items: center; justify-content: center;
      padding: 10px 12px; border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--tac-text); text-decoration: none; font-size: 11px;
    }
    .tac-secondary-btn:hover { border-color: var(--tac-accent); color: var(--tac-accent); }

    /* ═══ 底部 CLI 终端栏 ═══ */
    .os-terminal {
      background: #050608;
      border: 1px solid var(--tac-accent-border);
      display: flex; flex-direction: column; justify-content: space-between;
      padding: 6px 12px; overflow: hidden;
    }
    .term-output {
      font-size: 11.5px; color: var(--tac-muted);
      overflow-y: auto; max-height: 36px; line-height: 1.45;
    }
    .term-output b, .term-echo { color: var(--tac-accent); }
    .term-output a { color: var(--tac-ok); text-decoration: underline; }
    .term-ts { color: rgba(255, 255, 255, 0.3); margin-right: 4px; }
    .term-bar {
      display: flex; align-items: center; gap: 8px;
      border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 4px;
    }
    .term-prompt { color: var(--tac-ok); font-weight: 700; font-size: 12px; flex-shrink: 0; }
    .term-form { flex: 1; }
    .term-input {
      width: 100%; background: transparent; border: none; outline: none;
      color: var(--tac-text); font-family: inherit; font-size: 12px;
    }
    .term-quick-btns { display: flex; gap: 4px; }
    .term-quick-btns button {
      background: rgba(255, 255, 255, 0.05); color: var(--tac-muted);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 2px 8px; font-family: inherit; font-size: 10px; cursor: pointer;
    }
    .term-quick-btns button:hover {
      border-color: var(--tac-accent); color: var(--tac-accent);
    }

    /* ═══ 响应式降级：平板与手机端自动转为顺滑流式布局 ═══ */
    @media (max-width: 1100px) {
      html, body { overflow: auto; height: auto; }
      .os-shell { height: auto; grid-template-rows: auto auto auto; }
      .topbar-center { display: none; }
      .os-workspace { grid-template-columns: 1fr; }
      .panel-right { order: -1; }
      .matrix-grid { grid-template-columns: repeat(2, 1fr); max-height: 460px; }
      .chronicle-view { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .matrix-grid { grid-template-columns: 1fr; }
      .term-quick-btns { display: none; }
    }
  </style>
</body>
</html>
