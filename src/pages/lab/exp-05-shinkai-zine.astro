---
// 实验品五：SHINKAI NEO-ZINE // 新海诚 · 晴空日系映画画报
// 灵感源自站长博文《你的名字》：“线条与色彩的情绪表达、叙事节奏的留白”
// 100% 绑定 src/data 真实数据，融合日式竖排杂志排版 + 三段天色切换 + 35mm 胶片目录检视器
import { featured, projectsMain, projectsAI, projectsWeb } from '../../data/projects';
import { skillCategories, stats } from '../../data/skills';
import { honors, experience } from '../../data/timeline';

const safeHref = (href: string) => (href.startsWith('/') ? href : '/' + href);

const allProjects = [
  {
    num: '00',
    category: '全栈架构',
    emoji: featured.emoji,
    title: featured.title,
    desc: featured.desc,
    highlight: { value: '100/100', label: 'Lighthouse 性能满分 · Astro 5 + GSAP' },
    metrics: ['19 个静态编译页', '15 个 FastAPI 端点', 'OKLCH 双主题系统'],
    tech: featured.tags.map(t => t.label),
    cover: featured.cover,
    link: { href: safeHref(featured.href), label: '阅读详情报告' },
    group: 'web'
  },
  ...projectsMain.map(p => ({ ...p, link: p.link ? { ...p.link, href: safeHref(p.link.href) } : undefined, group: 'data' })),
  ...projectsAI.map(p => ({ ...p, link: p.link ? { ...p.link, href: safeHref(p.link.href) } : undefined, group: 'ai' })),
  ...projectsWeb.map(p => ({ ...p, link: p.link ? { ...p.link, href: safeHref(p.link.href) } : undefined, group: 'web' })),
].sort((a, b) => a.num.localeCompare(b.num));
---
<!DOCTYPE html>
<html lang="zh-CN" data-sky="daylight">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>实验品五 · 新月画報 Shinkai Neo-Zine — QT新月实验室</title>
  <meta name="description" content="QT新月作品集 实验品五：致敬新海诚色彩美学与日式竖排画报的个人作品集特刊。" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/noto-serif-sc-900.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <!-- 纸张微纹理遮罩 -->
  <div class="paper-grain" aria-hidden="true"></div>
  <!-- 天空背景光影与彗星粒子画布 -->
  <canvas class="sky-canvas" id="skyCanvas" aria-hidden="true"></canvas>

  <!-- ═══ 顶部出版物眉栏 (ZINE MASTHEAD BAR) ═══ -->
  <header class="zine-topbar">
    <div class="zine-topbar-inner">
      <div class="zt-left">
        <a href="/lab.html" class="zt-back">← 実験室へ戻る / LAB</a>
        <span class="zt-issue">新月画報 · 2026 特刊号 (VOL.05)</span>
      </div>

      <nav class="zt-nav" aria-label="画报章节导航">
        <a href="#sec-prologue">序章 · 人物</a>
        <a href="#sec-works">目録 · 作品 (15)</a>
        <a href="#sec-craft">技芸 · 技能</a>
        <a href="#sec-chronicle">軌跡 · 履历</a>
      </nav>

      <div class="zt-sky-switch" role="group" aria-label="新海诚天色切换">
        <button type="button" class="sky-btn active" data-sky-mode="daylight">☀️ 晴空</button>
        <button type="button" class="sky-btn" data-sky-mode="twilight">🌅 黄昏之时</button>
        <button type="button" class="sky-btn" data-sky-mode="comet">🌠 彗星夜空</button>
      </div>
    </div>
    <!-- 结绳红线装饰条 (Musubi Red Cord) -->
    <div class="musubi-cord" aria-hidden="true"></div>
  </header>

  <main class="zine-container">
    <!-- ═══ 第一幕：日系画报刊头 (HERO SPREAD) ═══ -->
    <section class="zine-hero" id="sec-prologue">
      <div class="hero-spread">
        <!-- 左栏：主文案与个人序言 -->
        <div class="spread-main">
          <div class="kicker-row">
            <span class="seal-red">新月</span>
            <span class="kicker-text">SHINKAI NEO-ZINE // PORTFOLIO ARCHIVE 2026</span>
          </div>

          <h1 class="zine-title">
            <span class="title-main">QT新月</span>
            <span class="title-sub">钟文清 · 个人全栈与 AI 作品特刊</span>
          </h1>

          <p class="zine-lead">
            <strong>AI / 数据工程 / 浏览器自动化 / 全栈开发。</strong>
            深圳职业技术大学人工智能技术应用专业 2026 届毕业生。在海客熵连科技独立负责多平台广告数据聚合监控系统（5800 行代码 / 日均监控 300+ 活跃账户），专注于用 <strong>Python、TensorFlow、MediaPipe、Playwright</strong> 解决真实世界的工程问题。
          </p>

          <!-- 引用自《你的名字》博文的核心设计哲学 -->
          <blockquote class="shinkai-quote">
            <p>“线条与色彩的情绪表达、叙事节奏的留白，其实和做个人作品集是相通的。每一次页面改版，我都试图留住那种‘似曾相识的悸动’。”</p>
            <cite>—— 摘自站长随笔《最爱电影分享：〈你的名字〉》</cite>
          </blockquote>

          <div class="hero-actions">
            <a href="#sec-works" class="zine-btn-primary">翻阅作品目録 (15) ↓</a>
            <a href="/blog/your-name.html" class="zine-btn-ghost">阅读《你的名字》随笔 →</a>
            <a href="/" class="zine-btn-ghost">返回主站</a>
          </div>
        </div>

        <!-- 中栏：新海诚式天空取景窗卡片 -->
        <div class="spread-window">
          <div class="window-frame">
            <div class="window-sky-art">
              <div class="comet-streak" aria-hidden="true"></div>
              <img src="/projects/covers/06-cartoon-gan.webp" alt="新海诚动漫风格迁移预览" class="window-img" />
              <div class="window-caption">
                <span>FIG.01 // 风景与代码交汇之处</span>
                <span>SHENZHEN · 22°32'N</span>
              </div>
            </div>
            <div class="dossier-mini">
              <div class="dm-row"><span>氏名 / NAME</span><b>钟文清 (Zhong Wenqing)</b></div>
              <div class="dm-row"><span>専攻 / MAJOR</span><b>人工智能技术应用 (2026届)</b></div>
              <div class="dm-row"><span>語学 / LANG</span><b>中文 · 日语 JLPT N2 (冲刺 N1) · EN</b></div>
              <div class="dm-row"><span>状態 / STATUS</span><b class="status-available">● 开放工作机会 (AI / 数据工程)</b></div>
