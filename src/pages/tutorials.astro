---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import VideoBg from '../components/VideoBg.astro';

// 教程元数据:accent 用于卡片描边/图标底色,与各教程内部主题色呼应
const tutorials = [
  {
    title: 'C++ 零基础入门教程',
    desc: '写给完全新手的 C++ 教程:20 章循序渐进,图解 + 可运行代码 + 练习 + 2 个实战项目。',
    href: '/tutorials/cpp-tutorial.html',
    icon: '🚀',
    accent: 'oklch(58% 0.2 265)',
    chapters: '20 章 · 41 节',
    tags: ['零基础', '图解', '实战项目'],
  },
  {
    title: '数据结构考研教程',
    desc: '考研 408 数据结构全考点:图解 + 考场手算模板 + 真题风格代码,衔接 C++ 入门教程。',
    href: '/tutorials/ds-tutorial.html',
    icon: '📊',
    accent: 'oklch(60% 0.11 190)',
    chapters: '全考点 · 23 节',
    tags: ['考研 408', '手算模板', '真题代码'],
  },
  {
    title: 'Spring 全家桶零基础图文教程',
    desc: 'Spring / Spring MVC / Spring Boot / MyBatis 四件套从零到跑通完整「用户管理」项目。',
    href: '/tutorials/Spring全家桶零基础图文教程.html',
    icon: '🌱',
    accent: 'oklch(65% 0.17 140)',
    chapters: '11 章 · 53 段代码',
    tags: ['Java 后端', '图文', '完整项目'],
  },
  {
    title: '零基础英语语法通关',
    desc: '从词性到三大从句的语法通关路线:每章配对比卡与小测,专治「规则都懂题不对」。',
    href: '/tutorials/零基础英语语法通关教程.html',
    icon: '📚',
    accent: 'oklch(70% 0.14 95)',
    chapters: '16 节 · 33 张对比卡',
    tags: ['零基础', '对比卡', '章末小测'],
  },
];
---
<Base
  title="教程 — QT新月 | 钟文清"
  description="QT新月的原创零基础教程:C++ 入门、数据结构考研 408、Spring 全家桶、英语语法。图解 + 可运行代码 + 章节练习,免费在线阅读。"
  canonical="https://qtxingyue.me/tutorials.html"
>
  <VideoBg />
  <Header />
  <main id="main">
    <section class="section tutorials-hero">
      <div class="container">
        <p class="section-label reveal">TUTORIALS</p>
        <h1 class="section-title reveal">原创教程</h1>
        <div class="section-divider reveal"></div>
        <p class="tutorials-intro reveal">
          写给零基础的长篇图文教程——图解、可运行代码、章末练习,全部免费在线阅读。
        </p>
        <div class="tutorial-grid">
          {tutorials.map(t => (
            <a class="tutorial-card reveal" href={t.href} style={`--tut-accent:${t.accent}`}>
              <span class="tutorial-icon" aria-hidden="true">{t.icon}</span>
              <h2 class="tutorial-title">{t.title}</h2>
              <p class="tutorial-desc">{t.desc}</p>
              <p class="tutorial-chapters">{t.chapters}</p>
              <div class="tutorial-tags">
                {t.tags.map(tag => <span class="skill-tag">{tag}</span>)}
              </div>
              <span class="tutorial-cta">开始阅读 →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <BackToTop />
</Base>

<style>
  .tutorials-hero { padding-top: calc(var(--header-h) + var(--space-4xl)); }
  .tutorials-intro {
    color: var(--text-secondary); max-width: 560px;
    margin-bottom: var(--space-2xl); line-height: 1.8;
  }
  .tutorial-grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }
  .tutorial-card {
    display: flex; flex-direction: column; gap: var(--space-md);
    padding: var(--space-xl);
    border: 1px solid var(--border); border-radius: 20px;
    background: var(--glass-bg);
    transition: transform 0.45s var(--ease-out-expo), border-color 0.3s, box-shadow 0.3s;
  }
  .tutorial-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--tut-accent) 55%, transparent);
    box-shadow: 0 24px 60px color-mix(in oklab, var(--tut-accent) 16%, transparent);
  }
  .tutorial-icon {
    width: 52px; height: 52px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem;
    background: color-mix(in oklab, var(--tut-accent) 18%, transparent);
    border: 1px solid color-mix(in oklab, var(--tut-accent) 35%, transparent);
  }
  .tutorial-title {
    font-family: var(--font-serif); font-weight: 900;
    font-size: var(--text-xl); color: var(--text-primary);
    line-height: 1.3; margin: 0;
  }
  .tutorial-desc { color: var(--text-secondary); line-height: 1.8; margin: 0; flex: 1; }
  .tutorial-chapters {
    font-size: var(--text-xs); color: var(--text-muted);
    letter-spacing: 0.08em; margin: 0;
  }
  .tutorial-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tutorial-cta { color: var(--tut-accent); font-weight: 700; font-size: var(--text-sm); }
  @media (max-width: 768px) {
    .tutorial-grid { grid-template-columns: 1fr; }
  }
</style>
