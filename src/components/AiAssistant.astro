---
// AiAssistant.astro — 前台 Hermes AI 简历智能导览浮窗
// 纯只读上下文沙箱 · OKLCH 双主题深度自适应 · 移动端抽屉适配
---

<div class="ai-assistant-wrapper" id="aiAssistantWrapper">
  <!-- 遮罩层 (移动端专用) -->
  <div class="ai-backdrop" id="aiBackdrop" aria-hidden="true"></div>

  <!-- 浮动唤起入口按钮 -->
  <button class="ai-trigger-btn" id="aiTriggerBtn" type="button" aria-label="打开 AI 简历导览助手" aria-expanded="false">
    <span class="ai-trigger-dot" aria-hidden="true"></span>
    <span class="ai-trigger-icon" aria-hidden="true">✦</span>
    <span class="ai-trigger-text">AI 助手</span>
  </button>

  <!-- 聊天悬浮面板 -->
  <section class="ai-panel" id="aiPanel" role="dialog" aria-label="Hermes AI 简历讲解助手" aria-hidden="true">
    <!-- 头部栏 -->
    <header class="ai-header">
      <div class="ai-header-info">
        <div class="ai-avatar" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><rect x="3" y="8" width="18" height="12" rx="4"/><circle cx="9" cy="13" r="1.5" fill="currentColor"/><circle cx="15" cy="13" r="1.5" fill="currentColor"/><path d="M10 17h4"/></svg>
        </div>
        <div>
          <h3 class="ai-title">Hermes · 简历讲解员</h3>
          <p class="ai-status"><span class="status-pulse"></span>在线 · 钟文清数字分身</p>
        </div>
      </div>
      <button class="ai-close-btn" id="aiCloseBtn" type="button" aria-label="关闭对话">✕</button>
    </header>

    <!-- 预设快捷问题推荐 -->
    <div class="ai-quick-prompts" id="aiQuickPrompts">
      <button type="button" class="quick-chip" data-query="钟文清最擅长哪些核心技术？">🎯 核心技术特长</button>
      <button type="button" class="quick-chip" data-query="介绍一下手势控制 PPT 项目的实现原理与亮点">🤖 手势控制 PPT</button>
      <button type="button" class="quick-chip" data-query="文清获得过哪些竞赛荣誉与证书？">🏆 竞赛荣誉与证书</button>
      <button type="button" class="quick-chip" data-query="如何联系作者钟文清？">📬 联系方式</button>
    </div>

    <!-- 消息对话流 -->
    <div class="ai-messages" id="aiMessages" role="log" aria-live="polite">
      <div class="message-bubble assistant">
        <div class="msg-avatar" aria-hidden="true">✦</div>
        <div class="msg-content">
          你好！我是钟文清的 AI 简历导览助手 <strong>Hermes</strong>。<br><br>
          我对文清的 <strong>14 个实战项目</strong>、<strong>深度学习与爬虫工程</strong>以及<strong>竞赛荣誉</strong>了如指掌。想了解什么尽管问我，也可以直接点击上方的快捷标签！
        </div>
      </div>
    </div>

    <!-- 底部输入框与状态 -->
    <footer class="ai-footer">
      <form class="ai-form" id="aiForm">
        <div class="ai-input-wrap">
          <input
            type="text"
            id="aiInput"
            class="ai-input"
            placeholder="问问文清的项目难点、技能或经历..."
            maxlength="150"
            autocomplete="off"
            aria-label="输入您的问题"
          />
          <span class="ai-char-count" id="aiCharCount">0/150</span>
        </div>
        <button type="submit" class="ai-send-btn" id="aiSendBtn" aria-label="发送消息">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </form>
      <p class="ai-disclaimer">由本地模型驱动 · 严守只读沙箱安全</p>
    </footer>
  </section>
</div>

<style>
  /* ═══ WRAPPER ═══ */
  .ai-assistant-wrapper {
    position: fixed;
    z-index: 999;
  }

  /* ═══ TRIGGER BUTTON ═══ */
  .ai-trigger-btn {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 92;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--glass-bg);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 10px 30px oklch(0% 0 0 / 0.25), 0 0 16px var(--accent-glow);
    transition: all 300ms var(--ease-out-expo);
  }

  [data-theme="light"] .ai-trigger-btn {
    background: oklch(100% 0 0 / 0.88);
    border-color: oklch(0% 0 0 / 0.1);
    box-shadow: 0 10px 28px oklch(30% 0.05 280 / 0.12), 0 0 12px var(--accent-glow);
  }

  .ai-trigger-btn:hover {
    transform: translateY(-2px) scale(1.03);
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 14px 36px oklch(0% 0 0 / 0.35), 0 0 24px var(--accent-glow);
  }

  .ai-trigger-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulseDot 2s infinite;
  }

  .ai-trigger-icon {
    font-size: 13px;
    color: var(--gold);
    line-height: 1;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  /* ═══ CHAT PANEL ═══ */
  .ai-panel {
    position: fixed;
    bottom: 5.4rem;
    right: 2rem;
    width: 390px;
    max-width: calc(100vw - 2rem);
    height: 560px;
    max-height: calc(100vh - 7rem);
    z-index: 95;
    display: flex;
    flex-direction: column;
    background: oklch(14% 0.015 270 / 0.86);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: 0 24px 60px oklch(0% 0 0 / 0.45), 0 0 24px var(--accent-glow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.96);
    transform-origin: bottom right;
    transition: opacity 280ms var(--ease-out-expo), transform 320ms var(--ease-out-expo), visibility 280ms;
  }

  [data-theme="light"] .ai-panel {
    background: oklch(100% 0 0 / 0.94);
    border-color: oklch(0% 0 0 / 0.1);
    box-shadow: 0 24px 50px oklch(30% 0.05 280 / 0.16), 0 1px 3px oklch(0% 0 0 / 0.05);
  }

  .ai-panel.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* ═══ HEADER ═══ */
  .ai-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, oklch(100% 0 0 / 0.03), transparent);
  }

  .ai-header-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-avatar {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--accent), var(--accent-dim));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px var(--accent-glow);
  }

  .ai-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    margin: 0;
  }

  .ai-status {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 2px;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    display: inline-block;
  }

  .ai-close-btn {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .ai-close-btn:hover {
    background: oklch(100% 0 0 / 0.08);
    color: var(--text-primary);
  }

  /* ═══ QUICK PROMPTS ═══ */
  .ai-quick-prompts {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--border);
    background: oklch(0% 0 0 / 0.08);
  }

  .ai-quick-prompts::-webkit-scrollbar {
    display: none;
  }

  .quick-chip {
    flex-shrink: 0;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--glass-bg);
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 200ms ease;
  }

  .quick-chip:hover {
    background: oklch(100% 0 0 / 0.1);
    border-color: var(--accent);
    color: var(--text-primary);
    transform: translateY(-1px);
  }

  [data-theme="light"] .quick-chip {
    background: oklch(100% 0 0 / 0.8);
  }

  /* ═══ MESSAGES AREA ═══ */
  .ai-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-behavior: smooth;
  }

  .message-bubble {
    display: flex;
    gap: 10px;
    max-width: 88%;
    animation: msgFadeIn 250ms var(--ease-out-expo);
  }

  @keyframes msgFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .message-bubble.assistant {
    align-self: flex-start;
  }

  .message-bubble.user {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .msg-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--gold));
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .msg-content {
    padding: 10px 14px;
    border-radius: 14px;
    font-size: var(--text-xs);
    line-height: 1.65;
    word-break: break-word;
    user-select: text;
  }

  .message-bubble.assistant .msg-content {
    background: oklch(20% 0.01 270 / 0.7);
    border: 1px solid var(--border);
    color: var(--text-primary);
    border-top-left-radius: 4px;
  }

  [data-theme="light"] .message-bubble.assistant .msg-content {
    background: oklch(95% 0.005 280 / 0.85);
    border-color: oklch(0% 0 0 / 0.08);
  }

  .message-bubble.user .msg-content {
    background: linear-gradient(135deg, var(--accent), oklch(50% 0.16 280));
    color: #ffffff;
    border-top-right-radius: 4px;
    box-shadow: 0 4px 14px var(--accent-glow);
  }

  /* 打字动画骨架 */
  .typing-dots {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 2px;
  }

  .typing-dots span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--text-secondary);
    animation: typingBounce 1.2s infinite ease-in-out;
  }

  .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
  .typing-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typingBounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
    40% { transform: translateY(-5px); opacity: 1; }
  }

  /* ═══ FOOTER & INPUT ═══ */
  .ai-footer {
    padding: 12px 14px 10px;
    border-top: 1px solid var(--border);
    background: linear-gradient(0deg, oklch(0% 0 0 / 0.08), transparent);
  }

  .ai-form {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-input-wrap {
    position: relative;
    flex: 1;
  }

  .ai-input {
    width: 100%;
    padding: 9px 48px 9px 12px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--glass-bg);
    color: var(--text-primary);
    font-size: var(--text-xs);
    font-family: inherit;
    outline: none;
    transition: border-color 200ms, box-shadow 200ms;
  }

  .ai-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .ai-char-count {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .ai-send-btn {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border: none;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 200ms var(--ease-out-expo);
  }

  .ai-send-btn:hover:not(:disabled) {
    background: oklch(50% 0.18 280);
    transform: scale(1.05);
  }

  .ai-send-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .ai-disclaimer {
    font-size: 10px;
    color: var(--text-muted);
    text-align: center;
    margin: 6px 0 0;
  }

  /* ═══ MOBILE BOTTOM SHEET ═══ */
  @media (max-width: 640px) {
    .ai-backdrop {
      position: fixed;
      inset: 0;
      background: oklch(0% 0 0 / 0.5);
      backdrop-filter: blur(4px);
      z-index: 94;
      opacity: 0;
      visibility: hidden;
      transition: all 260ms ease;
    }
    .ai-backdrop.active {
      opacity: 1;
      visibility: visible;
    }
    .ai-panel {
      bottom: 0;
      right: 0;
      left: 0;
      width: 100vw;
      max-width: 100vw;
      height: 75vh;
      max-height: 75vh;
      border-radius: 24px 24px 0 0;
      transform: translateY(100%);
      transform-origin: bottom center;
    }
    .ai-panel.active {
      transform: translateY(0);
    }
    .ai-trigger-btn {
      bottom: 1.2rem;
      right: 1.2rem;
      padding: 8px 14px;
    }
  }
</style>

<script is:inline>
(function initAiAssistant() {
  function setup() {
    const triggerBtn = document.getElementById('aiTriggerBtn');
    const panel = document.getElementById('aiPanel');
    const closeBtn = document.getElementById('aiCloseBtn');
    const backdrop = document.getElementById('aiBackdrop');
    const form = document.getElementById('aiForm');
    const input = document.getElementById('aiInput');
    const sendBtn = document.getElementById('aiSendBtn');
    const charCount = document.getElementById('aiCharCount');
    const messages = document.getElementById('aiMessages');
    const quickPrompts = document.getElementById('aiQuickPrompts');

    if (!triggerBtn || !panel || !form || !input) return;

    let isOpen = false;
    let isSending = false;

    function openPanel() {
      isOpen = true;
      panel.classList.add('active');
      panel.setAttribute('aria-hidden', 'false');
      triggerBtn.setAttribute('aria-expanded', 'true');
      if (backdrop) backdrop.classList.add('active');
      setTimeout(() => input.focus(), 150);
    }

    function closePanel() {
      isOpen = false;
      panel.classList.remove('active');
      panel.setAttribute('aria-hidden', 'true');
      triggerBtn.setAttribute('aria-expanded', 'false');
      if (backdrop) backdrop.classList.remove('active');
    }

    triggerBtn.onclick = () => {
      if (isOpen) closePanel();
      else openPanel();
    };

    if (closeBtn) closeBtn.onclick = closePanel;
    if (backdrop) backdrop.onclick = closePanel;

    // 字数统计
    input.oninput = () => {
      if (charCount) charCount.textContent = `${input.value.length}/150`;
    };

    // 快捷标签点击直接发送
    if (quickPrompts) {
      quickPrompts.querySelectorAll('.quick-chip').forEach(chip => {
        chip.onclick = () => {
          const query = chip.getAttribute('data-query');
          if (query && !isSending) {
            input.value = query;
            if (charCount) charCount.textContent = `${query.length}/150`;
            sendMessage(query);
          }
        };
      });
    }

    // 安全转义 HTML，杜绝 XSS
    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML.replace(/\n/g, '<br>');
    }

    // 添加气泡
    function appendMessage(role, text, isHtml = false) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `message-bubble ${role}`;
      
      const avatar = document.createElement('div');
      avatar.className = 'msg-avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = role === 'assistant' ? '✦' : '我';

      const content = document.createElement('div');
      content.className = 'msg-content';
      if (isHtml) {
        content.innerHTML = text;
      } else {
        content.innerHTML = escapeHtml(text);
      }

      msgDiv.appendChild(avatar);
      msgDiv.appendChild(content);
      messages.appendChild(msgDiv);
      messages.scrollTop = messages.scrollHeight;
      return msgDiv;
    }

    // 发送消息
    async function sendMessage(text) {
      if (!text.trim() || isSending) return;
      isSending = true;
      if (sendBtn) sendBtn.disabled = true;

      appendMessage('user', text);
      input.value = '';
      if (charCount) charCount.textContent = '0/150';

      // 展现等待动效
      const loadingBubble = appendMessage('assistant', '<div class="typing-dots"><span></span><span></span><span></span></div>', true);

      // 35s 超时兜底(后端公开路径已限 30s):避免打点动画一直转到两分钟
      const controller = new AbortController();
      const abortTimer = setTimeout(() => controller.abort(), 35000);
      try {
        const res = await fetch('/api/chat/assistant', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt: text.trim().slice(0, 150) }),
          signal: controller.signal
        });

        const data = await res.json();
        loadingBubble.remove();

        if (res.ok && data.ok) {
          appendMessage('assistant', data.reply);
        } else if (res.status === 429) {
          appendMessage('assistant', '提问太频繁啦，请稍等一分钟后再试哦 ☕');
        } else {
          appendMessage('assistant', data.detail || '抱歉，暂时未能连通 AI 助手，请稍后再试！');
        }
      } catch (err) {
        loadingBubble.remove();
        if (err && err.name === 'AbortError') {
          appendMessage('assistant', 'AI 助手响应超时了，请稍后再试一次！');
        } else {
          appendMessage('assistant', '网络连接出现一点小波动，欢迎直接通过页面底部的联系表单向文清留言！');
        }
      } finally {
        clearTimeout(abortTimer);
        isSending = false;
        if (sendBtn) sendBtn.disabled = false;
        input.focus();
      }
    }

    form.onsubmit = (e) => {
      e.preventDefault();
      sendMessage(input.value);
    };

    // ESC 键关闭:用 onkeydown 赋值而非 addEventListener——
    // setup 每次 SPA 导航都会重跑,addEventListener 会累积出越叠越多的监听器
    window.onkeydown = (e) => {
      if (e.key === 'Escape' && isOpen) {
        closePanel();
      }
    };
  }

  // 挂载到 astro:page-load 生命周期（Astro 5 ClientRouter）
  document.addEventListener('astro:page-load', setup);
  setup();
})();
</script>
