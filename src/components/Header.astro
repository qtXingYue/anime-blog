---
import ThemeToggle from './ThemeToggle.vue';
---
<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a href="#" class="brand"><span class="brand-mark">月</span><span>QT新月</span></a>
    <nav class="nav-links" id="navLinks" aria-label="主导航">
      <a href="/#about">关于</a>
      <a href="/#skills">技能</a>
      <a href="/#projects">项目</a>
      <a href="/lab.html">实验室</a>
      <a href="/blog.html">博客</a>
      <a href="/#contact">联系</a>
    </nav>
    <div class="header-actions">
      <!-- 标签由 VideoBg 的脚本按当前模式改写（视频 / 实验一 · 极光 / 静态） -->
      <button class="bg-toggle" id="bgToggle" aria-label="切换背景" title="切换背景">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7.5 3v18M16.5 3v18M3 8h4.5M3 16h4.5M16.5 8H21M16.5 16H21"/></svg>
      </button>
      <ThemeToggle client:idle />
      <button class="hamburger" id="hamburger" aria-label="导航菜单" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
<div class="drawer-backdrop" id="drawerBackdrop" aria-hidden="true"></div>
<nav class="mobile-drawer" id="mobileDrawer" aria-label="移动端导航">
  <div class="drawer-header">
    <span class="brand-mark">月</span>
    <button class="drawer-close" id="drawerClose" aria-label="关闭菜单">✕</button>
  </div>
  <div class="drawer-links">
    <a href="/#about">关于</a>
    <a href="/#skills">技能</a>
    <a href="/#projects">项目</a>
    <a href="/lab.html">实验室</a>
    <a href="/blog.html">博客</a>
    <a href="/#contact">联系</a>
  </div>
</nav>
