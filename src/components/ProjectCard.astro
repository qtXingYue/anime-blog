---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---
<article
  class="project-card"
  data-reveal
  data-accent={p.accent}
  data-pp
  data-pp-type={p.category}
  data-pp-name={p.title}
>
  <div class="project-visual" style={`background:${p.gradient}`}>
    {p.cover
      ? <img class="project-cover" src={p.cover} alt={`${p.title} 预览`} loading="lazy" decoding="async" width="880" height="550" />
      : <span class="project-visual-emoji" aria-hidden="true">{p.emoji}</span>}
    <span class="project-visual-tint" aria-hidden="true"></span>
  </div>
  <div>
    <p class="project-number">{p.num} / {p.category}</p>
    <!-- 共享元素:标题与详情页 h1 同名,ClientRouter 导航时做 morph -->
    <h3 class="project-title" transition:name={p.link ? `pt-${p.link.href.split('/').pop()}` : undefined}>{p.title}</h3>
    {p.highlight && (
      <p class="project-highlight">
        <b class="project-highlight-value">{p.highlight.value}</b>
        <span class="project-highlight-label">{p.highlight.label}</span>
      </p>
    )}
    <p class="project-desc">{p.desc}</p>
    <ul class="project-metrics">
      {p.metrics.map(m => <li>{m}</li>)}
    </ul>
    <div class="project-tech">
      {p.tech.map(t => <span class="skill-tag">{t}</span>)}
    </div>
    {p.link && <a class="project-link" href={p.link.href}>{p.link.label}</a>}
  </div>
</article>
