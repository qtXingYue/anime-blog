---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---
<article class="project-card" data-reveal>
  <div class="project-visual" style={`background:${p.gradient}`}>{p.emoji}</div>
  <div>
    <p class="project-number">{p.num} / {p.category}</p>
    <h3 class="project-title">{p.title}</h3>
    <p class="project-desc">{p.desc}</p>
    <ul class="project-metrics">
      {p.metrics.map(m => <li>{m}</li>)}
    </ul>
    <div class="project-tech">
      {p.tech.map(t => <span class="skill-tag">{t}</span>)}
    </div>
    {p.link && <a class="project-link" href={p.link.href}>{p.link.label}</a>}
  </div>
</article>
