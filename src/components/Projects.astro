---
import ProjectCard from './ProjectCard.astro';
import ProjectCardMedium from './ProjectCardMedium.astro';
import ProjectRow from './ProjectRow.astro';
import { featured, projectsFeature, projectsDepth, projectsIndex } from '../data/projects';
---
<section class="section" id="projects">
  <div class="container">
    <p class="section-label reveal">项目</p>
    <h2 class="section-title reveal">项目作品</h2>
    <div class="section-divider reveal"></div>
    <p class="projects-legend reveal">14 个项目 · 3 篇特写 · 6 个专题 · 5 则索引</p>

    <!-- 移动端专属吸顶分类筛选胶囊条 -->
    <nav class="mobile-project-tabs reveal" id="mobileProjectTabs" aria-label="项目分类导航">
      <button type="button" class="mobile-tab-btn active" data-target="#projects">全部</button>
      <button type="button" class="mobile-tab-btn" data-target=".projects-stack--feature">⭐ 特写 (3)</button>
      <button type="button" class="mobile-tab-btn" data-target="#bandDepth">🔬 专题 (6)</button>
      <button type="button" class="mobile-tab-btn" data-target="#bandIndex">📋 索引 (5)</button>
    </nav>

    <aside class="project-progress" id="projectProgress" aria-hidden="true">
      <span class="project-progress-count" id="projectProgressCount"><b>01</b><small>/ 05</small></span>
      <span class="project-progress-type" id="projectProgressType">核心工程</span>
      <span class="project-progress-name" id="projectProgressName">多平台广告数据爬取系统</span>
      <span class="project-progress-dots" id="projectProgressDots"></span>
    </aside>

    <a href={featured.href} class="featured-card reveal">
      <div class="featured-card-inner">
        <div class="featured-card-media" aria-hidden="true">
          <img src={featured.cover} alt="" loading="lazy" decoding="async" width="880" height="550" />
        </div>
        <div class="featured-card-body">
          <p class="featured-card-label">{featured.label}</p>
          <h3 class="featured-card-title" transition:name={`pt-${featured.href.split('/').pop()}`}>{featured.title} <span>{featured.titleSub}</span></h3>
          <p class="featured-card-desc">{featured.desc}</p>
          <div class="featured-card-tags">
            {featured.tags.map(t => (
              <span class={t.primary ? 'skill-tag primary' : 'skill-tag'}>{t.label}</span>
            ))}
          </div>
        </div>
        <div class="featured-card-cta">{featured.cta}</div>
      </div>
    </a>

    <div class="projects-stack projects-stack--feature">
      {projectsFeature.map(p => <ProjectCard project={p} />)}
    </div>
  </div>
</section>

<section class="section section--tight" id="projects-more">
  <div class="container">
    <div class="band-rule reveal" id="bandDepth" data-pp data-pp-type="专题" data-pp-name="6 个深度项目">
      <span class="band-rule-label">专题 · IN DEPTH</span>
      <span class="band-count">06</span>
    </div>
    <div class="projects-grid">
      {projectsDepth.map((p, i) => <ProjectCardMedium project={p} index={i} />)}
    </div>

    <div class="band-rule reveal" id="bandIndex" data-pp data-pp-type="索引" data-pp-name="5 则实验小品">
      <span class="band-rule-label">索引 · THE INDEX</span>
      <span class="band-count">05</span>
    </div>
    <ul class="projects-index">
      {projectsIndex.map((p, i) => <ProjectRow project={p} index={i} />)}
    </ul>
  </div>
</section>
