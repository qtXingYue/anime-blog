---
import ProjectCard from './ProjectCard.astro';
import { featured, projectsMain, projectsAI, projectsWeb } from '../data/projects';
---
<section class="section" id="projects">
  <div class="container">
    <p class="section-label reveal">项目</p>
    <h2 class="section-title reveal">项目作品</h2>
    <div class="section-divider reveal"></div>

    <aside class="project-progress" id="projectProgress" aria-hidden="true">
      <span class="project-progress-count" id="projectProgressCount"><b>01</b><small>/ 12</small></span>
      <span class="project-progress-type" id="projectProgressType">核心工程</span>
      <span class="project-progress-name" id="projectProgressName">多平台广告数据爬取系统</span>
      <span class="project-progress-dots" id="projectProgressDots"></span>
    </aside>

    <a href={featured.href} class="featured-card reveal">
      <div class="featured-card-inner">
        <div class="featured-card-icon">{featured.emoji}</div>
        <div class="featured-card-body">
          <p class="featured-card-label">{featured.label}</p>
          <h3 class="featured-card-title">{featured.title} <span>{featured.titleSub}</span></h3>
          <p class="featured-card-desc">{featured.desc}</p>
          <div class="featured-card-tags">
            {featured.tags.map(t => (
              <span class={t.primary ? 'skill-tag primary' : 'skill-tag'}>{t.label}</span>
            ))}
          </div>
        </div>
        <div class="featured-card-cta">{featured.cta}</div>
      </div>
    </a>

    <div class="projects-stack">
      {projectsMain.map(p => <ProjectCard project={p} />)}
    </div>
  </div>
</section>

<section class="section" id="projects-ai">
  <div class="container">
    <p class="section-label reveal">AI / 视觉</p>
    <h2 class="section-title reveal">AI / 视觉项目</h2>
    <div class="section-divider reveal"></div>
    <div class="projects-stack">
      {projectsAI.map(p => <ProjectCard project={p} />)}
    </div>
  </div>
</section>

<section class="section" id="projects-web">
  <div class="container">
    <p class="section-label reveal">Web / 小程序</p>
    <h2 class="section-title reveal">Web / 小程序</h2>
    <div class="section-divider reveal"></div>
    <div class="projects-stack">
      {projectsWeb.map(p => <ProjectCard project={p} />)}
    </div>
  </div>
</section>
