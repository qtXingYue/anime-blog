---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AiAssistant from '../components/AiAssistant.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
const {
  title = 'QT新月 — 个人作品集 | 钟文清',
  description = '钟文清的个人作品集 — 人工智能技术应用专业，深圳职业技术大学。涵盖深度学习、计算机视觉、数据工程、RPA 自动化、全栈开发等 14 个项目。',
  canonical = 'https://qtxingyue.me/',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<ClientRouter />
<meta name="description" content={description}>
<meta property="og:title" content="QT新月 — 钟文清的个人作品集">
<meta property="og:description" content="AI/数据工程/RPA 自动化/全栈开发 · 14 个实战项目 · 蓝桥杯省二等奖 · JLPT N2">
<meta property="og:type" content="website">
<meta property="og:url" content="https://qtxingyue.me/">
<meta property="og:site_name" content="QT新月">
<meta property="og:locale" content="zh_CN">
<meta property="og:image" content="https://qtxingyue.me/og-image.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#6d28d9">
<meta name="keywords" content="钟文清,QT新月,个人作品集,Python,深度学习,计算机视觉,数据工程,深圳职业技术大学">
<meta name="view-transition" content="same-origin">
<link rel="canonical" href={canonical}>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%236d28d9'/><text x='32' y='46' text-anchor='middle' font-size='36' font-family='sans-serif' fill='white'>月</text></svg>">
<!-- GSAP 自托管：国内直连，不依赖 cdnjs.cloudflare.com（该 CDN 不稳定会静默失效卡片堆叠） -->
<script src="/vendor/gsap.min.js" defer></script>
<script src="/vendor/ScrollTrigger.min.js" defer></script>
<!-- 标题衬线字体:自托管思源宋体子集(国内可直连,无 Google Fonts 依赖) -->
<!-- 只 preload 首屏大标题用的 900;700 仅供小标签,font-display:swap 自然加载,不抢高优先级带宽 -->
<link rel="preload" href="/fonts/noto-serif-sc-900.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" is:inline>
{"@context":"https://schema.org","@type":"Person","name":"钟文清","alternateName":"QT新月","url":"https://qtxingyue.me/","image":"https://qtxingyue.me/og-image.png","jobTitle":"人工智能技术应用学生 / 数据自动化开发者","affiliation":{"@type":"CollegeOrUniversity","name":"深圳职业技术大学"},"knowsAbout":["Python","Playwright","MediaPipe","OpenCV","TensorFlow","数据自动化","计算机视觉"],"sameAs":["https://github.com/qtXingYue"]}
</script>
<script is:inline>
  // 首屏前应用已保存主题，避免闪烁
  try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
</script>
<script is:inline>
  // 开屏加载：只在「会话内首次全量进入」且未开启减弱动效时启用。
  // 必须在首帧前打标记，否则会先闪一下正文再被盖住。
  (function () {
    try {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var seen = sessionStorage.getItem('qtx:splash-v1');
      if (!reduce && !seen) {
        document.documentElement.dataset.splash = '1';
        document.documentElement.classList.add('is-splashing');
      }
    } catch (e) {}
    // 兜底：万一脚本被禁用，3.6s 后 JS 仍未收场就直接把遮罩摘掉
    setTimeout(function () {
      var el = document.getElementById('splash');
      if (el && !el.dataset.done) {
        el.remove();
        document.documentElement.classList.remove('is-splashing');
        document.documentElement.removeAttribute('data-splash');
      }
    }, 3600);
  })();
</script>
</head>
<body>
<div id="splash" aria-hidden="true">
  <div class="splash-inner">
    <div class="splash-mark">
      <svg class="splash-ring" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
        <circle cx="60" cy="60" r="56"></circle>
      </svg>
      <span class="splash-glyph">月</span>
    </div>
    <p class="splash-brand">QT 新月<span>PORTFOLIO · 2026</span></p>
    <div class="splash-bar" aria-hidden="true"><i></i></div>
    <p class="splash-hint">正在装载作品集</p>
  </div>
</div>
<a href="#main" class="skip-link">跳至主要内容</a>
<main id="main">
<slot />
</main>
<AiAssistant />
<script>
import '../scripts/main.js';
import '../scripts/splash.js';
</script>
</body>
</html>
