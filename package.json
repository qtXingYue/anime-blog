{
  "name": "portfolio-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-sitemap.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:api": "cd ../server && python -m pytest test_main.py -v",
