    "quality": "npm run check && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "astro": "^5.0.0",
    "typescript": "^5.6.0"
  }
}
